<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>object_recognition</name>
  <version>0.0.0</version>
  <description>YOLOv8-based object recognition service for ROS2</description>

  <maintainer email="igoririondo2004@gmail.com">igor</maintainer>
  <license>Apache-2.0</license>

  <!-- ========================= -->
  <!-- BUILD DEPENDENCIES -->
  <!-- ========================= -->

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS2 core -->
  <depend>rclpy</depend>

  <!-- Messages -->
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>

  <!-- CV -->
  <depend>cv_bridge</depend>

  <!-- YOUR CUSTOM INTERFACES -->
  <depend>object_recognition_interfaces</depend>

  <!-- ========================= -->
  <!-- TESTING (optional) -->
  <!-- ========================= -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- ========================= -->
  <!-- EXPORT -->
  <!-- ========================= -->

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>